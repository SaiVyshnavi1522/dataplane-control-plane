HTTP_ADDR=:8080
GRPC_ADDR=:9091
DATABASE_URL=postgres://dataplane:dataplane@localhost:55432/dataplane?sslmode=disable
POSTGRES_PORT=55432
PROVISIONER=mock
WORKERS=4
JOB_POLL_INTERVAL=1s
WORKER_SHUTDOWN_TIMEOUT=10s
# Local resilience exercise only. Fails the first N attempts per operation.
FAILURE_INJECTION_ATTEMPTS=0
SNAPSHOT_ENDPOINT_TEMPLATE=http://localhost:9200
SNAPSHOT_S3_ENDPOINT=localhost:9000
SNAPSHOT_S3_BUCKET=dataplane-snapshots
SNAPSHOT_S3_REGION=us-east-1
# Development only: replace these keys and source credentials from a secret manager outside local use.
API_KEYS=local-admin:admin:local-admin-key-change-me,local-viewer:viewer:local-viewer-key-change-me
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
K8S_NAMESPACE=dataplane-clusters
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0
OPENSEARCH_STORAGE_SIZE=2Gi
# OPENSEARCH_STORAGE_CLASS=standard
# KUBECONFIG=/Users/you/.kube/config

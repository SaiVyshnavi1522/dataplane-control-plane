HTTP_ADDR=:8080
DATABASE_URL=postgres://dataplane:dataplane@localhost:55432/dataplane?sslmode=disable
POSTGRES_PORT=55432
PROVISIONER=mock
WORKERS=4
JOB_POLL_INTERVAL=1s
WORKER_SHUTDOWN_TIMEOUT=10s
# Local resilience exercise only. Fails the first N attempts per operation.
FAILURE_INJECTION_ATTEMPTS=0
K8S_NAMESPACE=dataplane-clusters
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.8.0
# KUBECONFIG=/Users/you/.kube/config
